# Copie para backend/.env (não versionado) para rodar localmente
FIREBASE_WEB_API_KEY=cole-a-chave-web-do-projeto-firebase
GCP_PROJECT=seu-projeto
REPOSITORY_BACKEND=memory
EXTRACTION_MODE=auto
TOLERANCIA_CENTAVOS=2
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
STATIC_DIR=../frontend/dist
# Layout da planilha (provisório até a confirmação do layout definitivo)
SHEET_COMPETENCIA_CELL=A2
SHEET_CODIGO_EMPRESA_CELL=E1
SHEET_CNPJ_CELL=E2
# SHEET_COLUNAS={"inss": "INSS EMPREGADO", "irrf": "IR EMPREGADO"}
# Emuladores: o caminho mais simples é o ambiente local em Docker (T14/T17), que já define tudo isso.
# ATENÇÃO: com FIREBASE_AUTH_EMULATOR_HOST ou FIRESTORE_EMULATOR_HOST definidos, a aplicação só sobe se
# GCP_PROJECT começar com "demo-" (o Admin SDK aceitaria tokens sem assinatura). Nunca no Cloud Run.
#   export FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
#   export FIRESTORE_EMULATOR_HOST=localhost:8080
#   GCP_PROJECT=demo-rpa
#   REPOSITORY_BACKEND=firestore
